fn append_number(frame: StringBuilder, n: i64) -> void {
    let s: str8 = format!("{}", n);
    builder_append(frame, s);
    free(s);
}

fn row_color(row: i64) -> i32 {
    if row == 0 { return color_bright_magenta(); }
    if row == 1 { return color_bright_red(); }
    if row == 2 { return color_bright_yellow(); }
    if row == 3 { return color_bright_green(); }
    return color_bright_cyan();
}

fn brick_color(level: i64, index: i64) -> i32 {
    let row: i64 = index / 12;
    let col: i64 = index % 12;
    let theme: i64 = (level - 1) % 8;
    if theme == 0 { return row_color((col * 3 + row) % 5); }
    if theme == 1 { return (col + row) % 2 == 0 ? color_bright_magenta() : color_bright_cyan(); }
    if theme == 2 {
        if col % 3 == 0 { return color_bright_red(); }
        return (col + row) % 2 == 0 ? color_bright_yellow() : color_red();
    }
    if theme == 3 {
        if col == 5 || col == 6 { return color_bright_white(); }
        return (col + row) % 2 == 0 ? color_bright_cyan() : color_bright_blue();
    }
    if theme == 4 { return row_color((col / 2 + row * 2) % 5); }
    if theme == 5 { return row_color(col / 3); }
    if theme == 6 {
        if col == 0 || col == 11 { return color_bright_yellow(); }
        return col % 2 == 0 ? color_bright_red() : color_bright_white();
    }
    if row == 0 { return color_bright_magenta(); }
    return col % 2 == 0 ? color_bright_green() : color_bright_cyan();
}

fn intro_line(frame: StringBuilder, row: i32, col: i32, text: str8, color: i32) -> void {
    builder_append(frame, cursor_pos(row, col));
    builder_append(frame, fg(color));
    builder_append(frame, text);
}

fn logo_row(row: i64) -> str8 {
    if row == 0 { return "## ## ##     ###  ####  ## ##  ###  ## ##  ###  ##### #### "; }
    if row == 1 { return "##### ##    ## ## ## ## ## ## ## ## ##### ## ##   #   ## ##"; }
    if row == 2 { return "##### ##    ## ## ## ## ####  ## ## ##### ## ##   #   ## ##"; }
    if row == 3 { return "## ## ##    ##### ####  ###   ##### ##### ## ##   #   ## ##"; }
    if row == 4 { return "## ## ##    ##### ####  ####  ##### ## ## ## ##   #   ## ##"; }
    if row == 5 { return "## ## ##### ## ## ## ## ## ## ## ## ## ## ## ##   #   ## ##"; }
    if row == 6 { return "## ## ##### ## ## ## ## ## ## ## ## ## ##  ###  ##### #### "; }
    return "";
}

fn logo_pixel(x: i64, y: i64) -> bool {
    if x < 0 || x >= 59 || y < 0 || y >= 7 { return false; }
    return byte_at(logo_row(y), x) == 35;
}

fn logo_gradient(row: i64) -> str8 {
    if row == 0 { return fg_rgb(255, 65, 80); }
    if row == 1 { return fg_rgb(255, 145, 65); }
    if row == 2 { return fg_rgb(255, 225, 150); }
    if row == 3 { return fg_rgb(245, 250, 255); }
    if row == 4 { return fg_rgb(145, 225, 255); }
    if row == 5 { return fg_rgb(65, 155, 245); }
    return fg_rgb(65, 85, 210);
}

fn render_logo(frame: StringBuilder, elapsed: i64) -> void {
    // Transparent lettering over an offset extrusion; half blocks bevel edges.
    for row in 5..13 {
        intro_line(frame, i32(row), 3, "                                                            ", color_default());
    }
    builder_append(frame, fg_rgb(30, 45, 105));
    for y in 0..7 {
        for x in 0..59 {
            if logo_pixel(x, y) {
                builder_append(frame, cursor_pos(i32(6 + y), i32(4 + x)));
                builder_append(frame, "▓");
            }
        }
    }
    let glint: i64 = elapsed / 90 % 90;
    for y in 0..7 {
        for x in 0..59 {
            if logo_pixel(x, y) {
                builder_append(frame, cursor_pos(i32(5 + y), i32(3 + x)));
                if x + y == glint { builder_append(frame, fg_rgb(255, 255, 255)); }
                else { builder_append(frame, logo_gradient(y)); }
                if !logo_pixel(x, y - 1) && !logo_pixel(x - 1, y) {
                    builder_append(frame, "▟");
                } else if !logo_pixel(x, y - 1) && !logo_pixel(x + 1, y) {
                    builder_append(frame, "▙");
                } else if !logo_pixel(x, y - 1) {
                    builder_append(frame, "▄");
                } else if !logo_pixel(x, y + 1) {
                    builder_append(frame, "▀");
                } else if !logo_pixel(x - 1, y) && logo_pixel(x + 1, y) {
                    builder_append(frame, "▐");
                } else if !logo_pixel(x + 1, y) && logo_pixel(x - 1, y) {
                    builder_append(frame, "▌");
                } else { builder_append(frame, "█"); }
            }
        }
    }
}

fn render_intro(frame: StringBuilder, elapsed: i64) -> void {
    builder_clear(frame);
    builder_append(frame, reset());
    intro_line(frame, 2, 2, "╔════════════════════════════════════════════════════════════╗", color_bright_blue());
    for row in 3..20 {
        intro_line(frame, i32(row), 2, "║", color_bright_blue());
        intro_line(frame, i32(row), 63, "║", color_bright_blue());
    }
    intro_line(frame, 20, 2, "╚════════════════════════════════════════════════════════════╝", color_bright_blue());
    for brick in 0..12 {
        intro_line(frame, 3, i32(3 + brick * 5), "▀▀▀▀", row_color((brick + elapsed / 250) % 5));
        intro_line(frame, 17, i32(3 + brick * 5), "▄▄▄▄", row_color((11 - brick + elapsed / 250) % 5));
    }
    intro_line(frame, 4, 22, "M L A R K A N O I D", color_bright_white());
    render_logo(frame, elapsed);
    intro_line(frame, 14, 17, "B R E A K   T H E   W A L L", color_bright_white());
    intro_line(frame, 15, 14, "3 LIVES  /  NEON BRICKS  /  BIG COMBOS", color_bright_black());
    intro_line(frame, 16, 3, "                                                            ", color_default());
    let travel: i64 = (elapsed / 35) % 108;
    let ball_col: i64 = 5 + (travel < 54 ? travel : 108 - travel);
    intro_line(frame, 16, i32(ball_col), "●", color_bright_white());
    intro_line(frame, 18, 27, "▐━━━━━━▌", color_bright_cyan());
    intro_line(frame, 21, 19, elapsed / 650 % 2 == 0 ? "[ PRESS SPACE OR ENTER ]" : "[                     ]", color_bright_yellow());
    intro_line(frame, 22, 13, "H/L or ←/→  ACCELERATE     P  PAUSE", color_bright_cyan());
    intro_line(frame, 23, 19, "T HIGH SCORES  /  Q QUIT", color_bright_black());
    builder_append(frame, reset());
    write(stdout(), builder_borrow_string(frame));
}

fn render_name(frame: StringBuilder, editor: StringBuilder) -> void {
    builder_clear(frame);
    builder_append(frame, reset());
    intro_line(frame, 5, 15, "◇ ENTER YOUR PILOT NAME ◇", color_bright_cyan());
    intro_line(frame, 8, 11, "Your personal best joins the top 10 pilots.", color_bright_white());
    intro_line(frame, 11, 20, "NAME > ", color_bright_yellow());
    builder_append(frame, builder_borrow_string(editor));
    builder_append(frame, "_             ");
    intro_line(frame, 14, 13, "A-Z / 0-9 / _ / -   UP TO 12 CHARACTERS", color_bright_black());
    intro_line(frame, 16, 14, "ENTER TO PLAY    BACKSPACE TO EDIT", color_bright_cyan());
    intro_line(frame, 18, 16, "ESC BACK / EMPTY NAME = PLAYER", color_bright_black());
    builder_append(frame, reset());
    write(stdout(), builder_borrow_string(frame));
}

fn render_highscores(table: &Highscores, frame: StringBuilder, failed: bool, over: bool) -> void {
    builder_clear(frame);
    builder_append(frame, reset());
    intro_line(frame, 2, 11, "◆ HALL OF FAME / TOP 10 PILOTS ◆", color_bright_cyan());
    intro_line(frame, 3, 16, over ? "GAME OVER / PERSONAL BESTS" : "PERSONAL BESTS / SAVED BETWEEN RUNS", color_bright_yellow());
    intro_line(frame, 5, 5, "RANK   PILOT               SCORE          WAVE", color_bright_black());
    intro_line(frame, 6, 5, "──────────────────────────────────────────────────────", color_bright_blue());
    for i in 0..10 {
        let color: i32 = i == 0 ? color_bright_yellow() : (i < 3 ? color_bright_cyan() : color_white());
        builder_append(frame, cursor_pos(i32(7 + i), 6));
        builder_append(frame, fg(color));
        append_number(frame, i + 1);
        intro_line(frame, i32(7 + i), 12, i < table.count ? table.names[i] : "---", color);
        builder_append(frame, cursor_pos(i32(7 + i), 32));
        if i < table.count { append_number(frame, table.points[i]); }
        else { builder_append(frame, "---"); }
        builder_append(frame, cursor_pos(i32(7 + i), 48));
        if i < table.count { append_number(frame, table.waves[i]); }
        else { builder_append(frame, "---"); }
    }
    intro_line(frame, 19, 8, failed ? "SAVE FAILED / scores kept in memory; retry on exit" : "Best score per name / ties ranked by highest wave", failed ? color_bright_red() : color_bright_black());
    intro_line(frame, 21, 10, over ? "R RESTART / N NEW PILOT / T RETURN / Q QUIT" : "T / ENTER / SPACE / ESC RETURN    Q QUIT", color_bright_cyan());
    builder_append(frame, reset());
    write(stdout(), builder_borrow_string(frame));
}

fn capsule_letter(kind: i64) -> str8 {
    if kind == 1 { return "E"; }
    if kind == 2 { return "S"; }
    if kind == 3 { return "C"; }
    if kind == 4 { return "P"; }
    if kind == 5 { return "MLA"; }
    return "NUKE";
}

fn capsule_color(kind: i64) -> i32 {
    if kind == 1 { return color_bright_cyan(); }
    if kind == 2 { return color_bright_yellow(); }
    if kind == 3 { return color_bright_green(); }
    if kind == 4 { return color_bright_magenta(); }
    return kind == 5 ? color_bright_white() : color_bright_red();
}

fn effect_timer(frame: StringBuilder, letter: str8, ticks: i64) -> void {
    if ticks > 0 {
        builder_append(frame, "  ");
        builder_append(frame, letter);
        builder_append(frame, ":");
        append_number(frame, (ticks + 124) / 125);
    }
}

fn render(g: &Game, frame: StringBuilder, too_small: bool, player: str8) -> void {
    builder_clear(frame);
    builder_append(frame, cursor_code(cmd_home()));
    builder_append(frame, reset());
    if too_small {
        builder_append(frame, "Resize to at least 64 x 24 to play.");
        builder_append(frame, clear_eol());
        builder_append(frame, "\r\nQ quits. Game suspended while resizing.");
        builder_append(frame, clear_eol());
        write(stdout(), builder_borrow_string(frame));
        return;
    }
    builder_append(frame, bold_on());
    builder_append(frame, fg(color_bright_cyan()));
    builder_append(frame, "  ▀▄ MLARKANOID ▄▀");
    builder_append(frame, fg(color_bright_black()));
    builder_append(frame, "     ");
    builder_append(frame, level_name(g.level));
    builder_append(frame, " / ");
    builder_append(frame, player);
    builder_append(frame, reset());
    builder_append(frame, clear_eol());
    builder_append(frame, "\r\n  SCORE ");
    builder_append(frame, fg(color_bright_yellow()));
    append_number(frame, g.score);
    builder_append(frame, reset());
    builder_append(frame, "   BEST ");
    append_number(frame, g.best);
    builder_append(frame, "   WAVE ");
    append_number(frame, g.level);
    builder_append(frame, "   LIVES ");
    builder_append(frame, fg(color_bright_red()));
    for i in 0..g.lives { builder_append(frame, "♥ "); }
    builder_append(frame, reset());
    builder_append(frame, clear_eol());
    builder_append(frame, "\r\n  CATCH: ");
    for kind in 1..7 {
        builder_append(frame, fg(capsule_color(kind)));
        builder_append(frame, capsule_letter(kind));
        if kind == 1 { builder_append(frame, " wide "); }
        if kind == 2 { builder_append(frame, " slow "); }
        if kind == 3 { builder_append(frame, " catch "); }
        if kind == 4 { builder_append(frame, " life "); }
        if kind == 5 { builder_append(frame, " full "); }
        if kind == 6 { builder_append(frame, " blast"); }
    }
    builder_append(frame, reset());
    builder_append(frame, clear_eol());
    builder_append(frame, "\r\n ");
    builder_append(frame, fg(color_bright_blue()));
    builder_append(frame, "╔");
    for x in 0..60 { builder_append(frame, "═"); }
    builder_append(frame, "╗");
    builder_append(frame, clear_eol());
    builder_append(frame, "\r\n");
    for y in 0..16 {
        builder_append(frame, fg(color_bright_blue()));
        builder_append(frame, " ║");
        for x in 0..60 {
            let capsule: i64 = capsule_at(g, x, y);
            if !g.over && x == g.ball_x / 1000 && y == g.ball_y / 1000 {
                builder_append(frame, fg(color_bright_white()));
                builder_append(frame, "●");
            } else if y == 14 && x >= g.paddle / 1000 && x < g.paddle / 1000 + paddle_width(g) / 1000 {
                builder_append(frame, fg(color_bright_cyan()));
                if x == g.paddle / 1000 { builder_append(frame, "▐"); }
                else if x == g.paddle / 1000 + paddle_width(g) / 1000 - 1 { builder_append(frame, "▌"); }
                else { builder_append(frame, "━"); }
            } else if capsule >= 0 {
                builder_append(frame, fg(capsule_color(g.drop_kind[capsule])));
                let offset: i64 = x - g.drop_x[capsule] / 1000;
                if g.drop_kind[capsule] == 6 {
                    if offset == -2 { builder_append(frame, "["); }
                    if offset == -1 { builder_append(frame, "N"); }
                    if offset == 0 { builder_append(frame, "U"); }
                    if offset == 1 { builder_append(frame, "K"); }
                    if offset == 2 { builder_append(frame, "E"); }
                    if offset == 3 { builder_append(frame, "]"); }
                } else if g.drop_kind[capsule] == 5 {
                    if offset == -2 { builder_append(frame, "["); }
                    if offset == -1 { builder_append(frame, "M"); }
                    if offset == 0 { builder_append(frame, "L"); }
                    if offset == 1 { builder_append(frame, "A"); }
                    if offset == 2 { builder_append(frame, "]"); }
                } else {
                    if offset < 0 { builder_append(frame, "["); }
                    else if offset > 0 { builder_append(frame, "]"); }
                    else { builder_append(frame, capsule_letter(g.drop_kind[capsule])); }
                }
            } else if g.blast_ticks > 0 && magnitude(magnitude(x - 30) + magnitude(y - 8) * 2 - (100 - g.blast_ticks) / 2) < 2 {
                builder_append(frame, fg(color_bright_yellow()));
                builder_append(frame, "✦");
            } else if y >= 2 && y < 7 && x % 5 < 4 && g.bricks[(y - 2) * 12 + x / 5] > 0 {
                builder_append(frame, fg(brick_color(g.level, (y - 2) * 12 + x / 5)));
                let index: i64 = (y - 2) * 12 + x / 5;
                if g.bricks[index] > 1 && (x % 5 == 0 || x % 5 == 3) {
                    builder_append(frame, fg(color_bright_white()));
                }
                builder_append(frame, brick_glyph(g.level, index, g.bricks[index], x % 5));
            } else if g.flash_ticks > 0 && y == g.flash_y && magnitude(x - g.flash_x) < 3 {
                builder_append(frame, fg(color_bright_yellow()));
                builder_append(frame, "·");
            } else if y == 15 {
                builder_append(frame, fg(color_bright_black()));
                builder_append(frame, "░");
            } else { builder_append(frame, " "); }
        }
        builder_append(frame, fg(color_bright_blue()));
        builder_append(frame, "║");
        builder_append(frame, reset());
        builder_append(frame, clear_eol());
        builder_append(frame, "\r\n");
    }
    builder_append(frame, fg(color_bright_blue()));
    builder_append(frame, " ╚");
    for x in 0..60 { builder_append(frame, "═"); }
    builder_append(frame, "╝");
    builder_append(frame, reset());
    builder_append(frame, clear_eol());
    builder_append(frame, "\r\n  ");
    builder_append(frame, fg(color_bright_yellow()));
    if g.over { builder_append(frame, "GAME OVER / R restart / N new pilot / T scores"); }
    else if g.paused { builder_append(frame, "PAUSED / P to resume"); }
    else if g.ready && g.blast_ticks > 0 { builder_append(frame, "NUKE! WAVE CLEARED / SPACE to launch"); }
    else if g.ready {
        builder_append(frame, g.catch_ticks > 0 ? "CAUGHT / SPACE to release" : "READY / SPACE to launch");
    }
    else {
        builder_append(frame, "COMBO x");
        append_number(frame, clamp(g.combo, 1, 8));
        builder_append(frame, "    THRUST ");
        for i in 0..8 {
            builder_append(frame, magnitude(g.velocity) / 4500 > i ? "▰" : "▱");
        }
    }
    effect_timer(frame, "MLA", g.mla_ticks);
    effect_timer(frame, "E", g.expand_ticks);
    effect_timer(frame, "S", g.slow_ticks);
    effect_timer(frame, "C", g.catch_ticks);
    builder_append(frame, reset());
    builder_append(frame, clear_eol());
    builder_append(frame, "\r\n  H/L ←/→ move  SPACE launch  P pause  R reset  T scores  Q quit");
    builder_append(frame, clear_eol());
    write(stdout(), builder_borrow_string(frame));
}

fn main() -> i32 {
    if stdin_is_tty() != 1 || stdout_is_tty() != 1 || supports_ansi() != 1 {
        println!("Run ./run.sh in an ANSI terminal (at least 64 columns x 24 rows).");
        return 1;
    }
    if stdin_enable_raw() != 0 {
        println!("Unable to enable terminal raw input.");
        return 1;
    }
    print!("{}{}{}", alt_screen_on(), cursor_code(cmd_hide()), cursor_code(cmd_clear_screen()));
    let score_file: str8 = highscore_path();
    var scores: Highscores = load_highscores(score_file);
    var g: Game = new_game(scores.count > 0 ? scores.points[0] : 0);
    var player: str8 = format!("PLAYER");
    let name_editor: StringBuilder = builder_new(32);
    var naming: bool = false;
    var showing_scores: bool = false;
    var save_failed: bool = false;
    var last_recorded: i64 = 0;
    var over_seen: bool = false;
    let frame: StringBuilder = builder_new(16000);
    var running: bool = true;
    var welcome: bool = true;
    var direction: i64 = 0;
    var input_until: i64 = 0;
    var launch_after: i64 = 0;
    var escape_state: i32 = 0;
    var escape_until: i64 = 0;
    var previous: i64 = now_ms();
    let intro_started: i64 = previous;
    var accumulator: i64 = 0;
    var next_frame: i64 = 0;
    var was_small: bool = false;
    while running {
        let now: i64 = now_ms();
        let size: TermSize = stdout_size();
        let small: bool = size.cols < 64 || size.rows < 24;
        if now > escape_until { escape_state = 0; }
        // Bound draining so an input flood cannot starve physics/rendering.
        for i in 0..128 {
            let key: i32 = read_keycode_nonblocking(stdin());
            if key == -2 { break; }
            if key == -1 || key == 3 { running = false; break; }
            if naming {
                if !small && (key == 13 || key == 10) {
                    free(player);
                    player = normalize_name(builder_borrow_string(name_editor));
                    naming = false;
                    g = new_game(scores.count > 0 ? scores.points[0] : 0);
                    last_recorded = 0;
                    over_seen = false;
                    launch_after = now + 250;
                    print!("{}", cursor_code(cmd_clear_screen()));
                    break;
                } else if key == 27 {
                    naming = false;
                    welcome = true;
                    print!("{}", cursor_code(cmd_clear_screen()));
                } else if key == 127 || key == 8 {
                    if builder_len(name_editor) > 0 {
                        let old: str8 = builder_to_string(name_editor);
                        let shortened: str8 = sub(old, 0, len(old) - 1);
                        builder_clear(name_editor);
                        builder_append(name_editor, shortened);
                        free(shortened);
                        free(old);
                    }
                } else if name_key(key) != 0 && builder_len(name_editor) < 12 {
                    builder_append_char(name_editor, name_key(key));
                }
                continue;
            }
            if key == 113 || key == 81 { running = false; break; }
            if g.over && (key == 110 || key == 78) {
                showing_scores = false;
                naming = true;
                builder_clear(name_editor);
                print!("{}", cursor_code(cmd_clear_screen()));
                continue;
            }
            if showing_scores {
                if g.over && (key == 114 || key == 82) {
                    g = new_game(scores.count > 0 ? scores.points[0] : g.best);
                    last_recorded = 0;
                    over_seen = false;
                    showing_scores = false;
                } else if key == 116 || key == 84 || key == 13 || key == 10 || key == 32 || key == 27 {
                    showing_scores = false;
                    launch_after = now + 250;
                }
                print!("{}", cursor_code(cmd_clear_screen()));
                continue;
            }
            if key == 116 || key == 84 {
                showing_scores = true;
                direction = 0;
                input_until = 0;
                print!("{}", cursor_code(cmd_clear_screen()));
                continue;
            }
            if welcome {
                if !small && (key == 32 || key == 13 || key == 10) {
                    welcome = false;
                    naming = true;
                    builder_clear(name_editor);
                    escape_state = 0;
                    accumulator = 0;
                    launch_after = now + 250;
                    print!("{}", cursor_code(cmd_clear_screen()));
                    // Give the start key time to settle before accepting a launch.
                    break;
                }
                continue;
            }
            var movement: i64 = 0;
            if escape_state == 1 {
                escape_state = key == 91 || key == 79 ? 2 : 0;
                continue;
            }
            if escape_state == 2 {
                if key == 68 { movement = -1; }
                if key == 67 { movement = 1; }
                escape_state = 0;
            } else if key == 27 {
                escape_state = 1;
                escape_until = now + 80;
                continue;
            } else if key == 104 || key == 72 { movement = -1; }
            else if key == 108 || key == 76 { movement = 1; }
            else if key == 32 && now >= launch_after { launch(&mut g); }
            else if key == 112 || key == 80 {
                g.paused = !g.paused;
                direction = 0;
                input_until = 0;
                g.velocity = 0;
            } else if key == 114 || key == 82 {
                let best: i64 = g.best;
                g = new_game(best);
                last_recorded = 0;
                over_seen = false;
                direction = 0;
                input_until = 0;
            }
            if movement != 0 {
                // A short lease bridges terminal key repeats without key-up events.
                direction = movement;
                input_until = now + 180;
            }
        }
        if small != was_small {
            print!("{}", cursor_code(cmd_clear_screen()));
            was_small = small;
        }
        accumulator += clamp(now - previous, 0, 64);
        previous = now;
        if small || welcome || naming || showing_scores { accumulator = 0; }
        while accumulator >= 8 {
            tick(&mut g, now <= input_until ? direction : 0);
            accumulator -= 8;
        }
        if !welcome && !naming && g.score > last_recorded {
            if record_score(&mut scores, player, g.score, g.level) {
                save_failed = !save_highscores(&scores, score_file);
            }
            last_recorded = g.score;
        }
        if g.over && !over_seen && !naming {
            over_seen = true;
            showing_scores = true;
            print!("{}", cursor_code(cmd_clear_screen()));
        }
        if now >= next_frame {
            if showing_scores && !small { render_highscores(&scores, frame, save_failed, g.over); }
            else if naming && !small { render_name(frame, name_editor); }
            else if welcome && !small { render_intro(frame, now - intro_started); }
            else { render(&g, frame, small, player); }
            next_frame = now + 16;
        }
        sleep_ms(2);
    }
    if save_failed { save_failed = !save_highscores(&scores, score_file); }
    builder_free(name_editor);
    builder_free(frame);
    free_highscores(&mut scores);
    free(player);
    let _ = stdin_restore();
    print!("{}{}{}\n", reset(), cursor_code(cmd_show()), alt_screen_off());
    if save_failed { println!("High scores could not be saved to {}", score_file); }
    free(score_file);
    return 0;
}
