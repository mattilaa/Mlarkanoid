// Physics uses thousandths of a terminal cell and a fixed 8 ms timestep.
// Horizontal cells are roughly half as wide as terminal rows are tall.
pub struct Game {
    var bricks: list<i64>;
    var drop_kind: list<i64>;
    var drop_x: list<i64>;
    var drop_y: list<i64>;
    var party_x: list<i64>;
    var party_y: list<i64>;
    var previous_brick_x: list<i64>;
    var previous_brick_y: list<i64>;
    var party_active: bool;
    var party_step_ticks: i64;
    var party_seed: i64;
    var broken: i64;
    var blast_ticks: i64;
    var mla_ticks: i64;
    var expand_ticks: i64;
    var slow_ticks: i64;
    var catch_ticks: i64;
    var scatter_ticks: i64;
    var hole_ticks: i64;
    var fast_ticks: i64;
    var xtc_rate: i64;
    var lsd_doses: i64;
    var xtc_doses: i64;
    var chaos_kick_ticks: i64;
    var chaos_seed: i64;
    var xtc_ticks: i64;
    var xtc_phase: i64;
    var lsd_rate: i64;
    var drop_seed: i64;
    var glow_phase: i64;
    var glow_direction: i64;
    var glow_turn_ticks: i64;
    var glow_seed: i64;
    var lsd_ticks: i64;
    var lsd_seed: i64;
    var lsd_step_ticks: i64;
    var lsd_control_ticks: i64;
    var lsd_mistake_ticks: i64;
    var lsd_mistake: i64;
    var brick_shift_x: i64;
    var brick_shift_y: i64;
    var brick_drift_x: i64;
    var brick_drift_y: i64;
    var direction_seed: i64;
    var side_shot: bool;
    var vertical_ticks: i64;
    var vertical_direction: i64;
    var angle_ticks: i64;
    var angle_direction: i64;
    var paddle: i64;
    var velocity: i64;
    var ball_x: i64;
    var ball_y: i64;
    var ball_vx: i64;
    var ball_vy: i64;
    var score_reset_ticks: i64;
    var score: i64;
    var best: i64;
    var lives: i64;
    var level: i64;
    var remaining: i64;
    var combo: i64;
    var ready: bool;
    var paused: bool;
    var over: bool;
    var flash_x: i64;
    var flash_y: i64;
    var flash_ticks: i64;
};

pub fn magnitude(n: i64) -> i64 { return n < 0 ? -n : n; }

fn set_brick(bricks: &mut list<i64>, index: i64, hp: i64) -> void {
    bricks[index] = hp;
}

pub fn clamp(n: i64, low: i64, high: i64) -> i64 {
    return n < low ? low : (n > high ? high : n);
}

// Capsule kinds: 1 E, 2 S, 3 C, 4 P, 5 MLA, 6 NUKE, 7 A, 8 D, 9 H, 10 F, 11 LSD, 12 V (upright paddle), 13 XTC (stationary disco glow), 14 X (catch or lose current score).
fn empty_slots() -> list<i64> {
    var slots: list<i64> = [];
    for i in 0..8 { slots.push(0); }
    return slots;
}

fn brick_offsets() -> list<i64> {
    var offsets: list<i64> = [];
    for i in 0..60 { offsets.push(0); }
    return offsets;
}

pub fn paddle_width(g: &Game) -> i64 {
    if g.mla_ticks > 0 { return 60000; }
    if g.vertical_ticks > 0 { return 1000; }
    return g.expand_ticks > 0 ? 12000 : 8000;
}

pub fn paddle_vertical(g: &Game) -> bool { return g.vertical_ticks > 0 && g.mla_ticks == 0; }

pub fn paddle_height(g: &Game) -> i64 {
    return paddle_vertical(g) ? (g.expand_ticks > 0 ? 6000 : 4000) : 0;
}

pub fn paddle_top(g: &Game) -> i64 { return 14000 - paddle_height(g); }

pub fn paddle_gap_at(g: &Game, x: i64, y: i64) -> bool {
    if g.hole_ticks == 0 { return false; }
    if paddle_vertical(g) {
        let middle: i64 = 14000 - paddle_height(g) / 2;
        return y >= middle - 1000 && y < middle + 1000;
    }
    return hole_at(g.paddle, paddle_width(g), x);
}

pub fn paddle_angle(g: &Game) -> i64 {
    if g.angle_ticks == 0 || g.mla_ticks > 0 || paddle_vertical(g) { return 0; }
    return g.angle_direction;
}

// Rows are twice as tall as columns: a physical 45-degree ramp rises one
// row for every two columns. Its lower endpoint remains at the old paddle row.
fn surface_at(left: i64, width: i64, angle: i64, x: i64) -> i64 {
    if angle == 0 { return 14000; }
    if angle < 0 { return 14000 - (x - left) / 2; }
    return 14000 - width / 2 + (x - left) / 2;
}

pub fn paddle_surface(g: &Game, x: i64) -> i64 {
    if paddle_vertical(g) { return paddle_top(g); }
    return surface_at(g.paddle, paddle_width(g), paddle_angle(g), x);
}

fn hole_at(left: i64, width: i64, x: i64) -> bool {
    let center: i64 = left + width / 2;
    let half_gap: i64 = width >= 12000 ? 2000 : 1000;
    return x >= center - half_gap && x < center + half_gap;
}

pub fn paddle_hole(g: &Game, x: i64) -> bool {
    return !paddle_vertical(g) && g.hole_ticks > 0 && hole_at(g.paddle, paddle_width(g), x);
}

pub fn paddle_rest_x(g: &Game) -> i64 {
    // A held ball sits on a solid segment, never over the center gap.
    if paddle_vertical(g) { return g.paddle + 500; }
    return g.paddle + paddle_width(g) / (g.hole_ticks > 0 ? 4 : 2);
}

pub fn paddle_at(g: &Game, x: i64, y: i64) -> bool {
    if paddle_vertical(g) {
        return x == g.paddle / 1000 && y >= paddle_top(g) / 1000 && y < 14 &&
               !paddle_gap_at(g, x * 1000 + 500, y * 1000 + 500);
    }
    if x < g.paddle / 1000 || x >= g.paddle / 1000 + paddle_width(g) / 1000 { return false; }
    if paddle_hole(g, x * 1000 + 500) { return false; }
    return y == paddle_surface(g, x * 1000 + 500) / 1000;
}

pub fn paddle_glyph(g: &Game, x: i64) -> str8 {
    // Two half-height cells join into one solid diagonal on 2:1 terminals.
    // Choose the half from the same surface used by collision detection so
    // the pattern remains aligned as the paddle moves between cell columns.
    let surface: i64 = paddle_surface(g, x * 1000 + 500);
    return surface % 1000 < 500 ? "▀" : "▄";
}

fn integer_sqrt(squared: i64) -> i64 {
    var low: i64 = 0;
    var high: i64 = 100000;
    while low + 1 < high {
        let middle: i64 = (low + high) / 2;
        if middle * middle <= squared { low = middle; } else { high = middle; }
    }
    return low < 1000 ? 1000 : low;
}

fn diagonal_speed(vx: i64, vy: i64) -> i64 {
    // Account for the 2:1 terminal cell aspect ratio when conserving speed.
    return integer_sqrt(((vx / 2) * (vx / 2) + vy * vy) / 2);
}

fn set_ball_direction(g: &mut Game, shot: i64) -> void {
    let speed: i64 = integer_sqrt((g.ball_vx / 2) * (g.ball_vx / 2) + g.ball_vy * g.ball_vy);
    let diagonal: i64 = diagonal_speed(g.ball_vx, g.ball_vy);
    g.side_shot = false;
    if shot == 0 { g.ball_vx = 0; g.ball_vy = -speed; }
    if shot == 1 { g.ball_vx = -diagonal * 2; g.ball_vy = -diagonal; }
    if shot == 2 { g.ball_vx = diagonal * 2; g.ball_vy = -diagonal; }
    if shot == 3 { g.ball_vx = -speed * 2; g.ball_vy = 0; g.side_shot = true; }
    if shot == 4 { g.ball_vx = speed * 2; g.ball_vy = 0; g.side_shot = true; }
    if shot == 5 { g.ball_vx = -diagonal * 2; g.ball_vy = diagonal; }
    if shot == 6 { g.ball_vx = diagonal * 2; g.ball_vy = diagonal; }
    if shot == 7 { g.ball_vx = 0; g.ball_vy = speed; }
}

pub fn scatter_rebound(g: &mut Game) -> void {
    g.direction_seed = g.direction_seed * 48271 % 2147483647;
    let shot: i64 = g.direction_seed % 5;
    set_ball_direction(&mut g, shot);
}

pub fn chaos_level(g: &Game) -> i64 {
    if g.lsd_ticks == 0 || g.xtc_ticks == 0 { return 0; }
    return clamp(g.lsd_doses + g.xtc_doses - 1, 1, 8);
}

pub fn chaos_interval(g: &Game) -> i64 { return 200 - chaos_level(g) * 20; }

pub fn tick_chaos_ball(g: &mut Game) -> void {
    let level: i64 = chaos_level(g);
    if level == 0 { g.chaos_kick_ticks = 0; return; }
    if g.ready || g.paused || g.over { return; }
    if g.chaos_kick_ticks > 0 { g.chaos_kick_ticks -= 1; return; }
    g.chaos_seed = g.chaos_seed * 48271 % 2147483647;
    let choices: i64 = level >= 3 ? 8 : 5;
    let shot: i64 = g.chaos_seed % choices;
    set_ball_direction(&mut g, shot);
    let interval: i64 = chaos_interval(g);
    g.chaos_kick_ticks = interval + g.chaos_seed % 25;
}

pub fn lsd_duration_ticks() -> i64 { return 5625; } // 45 seconds at 125 Hz.
pub fn xtc_duration_ticks() -> i64 { return 1875; } // 15 seconds at 125 Hz.

pub fn score_multiplier(g: &Game) -> i64 {
    if g.lsd_ticks > 0 && g.xtc_ticks > 0 { return 10; }
    return g.lsd_ticks > 0 ? 3 : (g.xtc_ticks > 0 ? 2 : 1);
}

pub fn award_points(g: &mut Game, points: i64) -> void {
    g.score += points * score_multiplier(g);
    if g.score > g.best { g.best = g.score; }
}

pub fn capsule_for_break(g: &mut Game) -> i64 {
    g.drop_seed = g.drop_seed * 48271 % 2147483647;
    let roll: i64 = g.drop_seed % 100;
    if roll < g.lsd_rate { return 11; }
    if roll < g.lsd_rate + g.xtc_rate { return 13; }
    let kind: i64 = (g.broken / 3 - 1) % 12 + 1;
    if kind == 11 { return 12; }
    return kind == 12 ? 14 : kind;
}

pub fn brick_left(g: &Game, index: i64) -> i64 {
    return (index % 12 * 5 + g.brick_shift_x + (g.party_active ? g.party_x[index] : 0)) * 1000;
}

pub fn brick_top(g: &Game, index: i64) -> i64 {
    return (index / 12 + 2 + g.brick_shift_y + (g.party_active ? g.party_y[index] : 0)) * 1000;
}

pub fn brick_at(g: &Game, x: i64, y: i64) -> i64 {
    if g.party_active {
        for i in 0..60 {
            if g.bricks[i] > 0 && y == brick_top(g, i) / 1000 &&
               x >= brick_left(g, i) / 1000 && x < brick_left(g, i) / 1000 + 4 { return i; }
        }
        return -1;
    }
    let col: i64 = x - g.brick_shift_x;
    let row: i64 = y - g.brick_shift_y;
    if col < 0 || col >= 60 || row < 2 || row >= 7 || col % 5 >= 4 { return -1; }
    let index: i64 = (row - 2) * 12 + col / 5;
    return g.bricks[index] > 0 ? index : -1;
}

fn reset_party(g: &mut Game) -> void {
    g.party_active = false;
    g.chaos_kick_ticks = 0;
    g.party_step_ticks = 0;
    for i in 0..60 {
        set_brick(&mut g.party_x, i, 0);
        set_brick(&mut g.party_y, i, 0);
    }
}

pub fn brick_space_free(g: &Game, index: i64, left: i64, top: i64) -> bool {
    // An eight-row play area stays clear of even expanded tilted/upright pads.
    if left < 0 || left + 4 > 60 || top < 0 || top + 1 > 8 { return false; }
    for i in 0..60 {
        if i != index && g.bricks[i] > 0 {
            let other_left: i64 = brick_left(g, i) / 1000;
            let other_top: i64 = brick_top(g, i) / 1000;
            if left < other_left + 4 && left + 4 > other_left &&
               top < other_top + 1 && top + 1 > other_top { return false; }
        }
    }
    return true;
}

pub fn tick_party_bricks(g: &mut Game) -> void {
    if g.lsd_ticks == 0 || g.xtc_ticks == 0 {
        if g.party_active { reset_party(&mut g); }
        return;
    }
    if !g.party_active {
        // Start from a non-overlapping formation entirely above the paddle.
        g.brick_shift_y = clamp(g.brick_shift_y, -2, 1);
        g.party_active = true;
        g.party_step_ticks = 0;
        g.party_seed = (g.score * 13 + g.lsd_seed + 1) % 2147483646 + 1;
    }
    if g.party_step_ticks > 0 { g.party_step_ticks -= 1; return; }
    g.party_seed = g.party_seed * 48271 % 2147483647;
    let index: i64 = g.party_seed % 60;
    // Attempt one brick move per 8 ms physics step. Other bricks stay still
    // during that step, so a clear unit move cannot cross another trajectory.
    if g.bricks[index] > 0 {
        g.party_seed = g.party_seed * 48271 % 2147483647;
        let direction: i64 = g.party_seed % 4;
        let dx: i64 = direction == 0 ? -1 : (direction == 1 ? 1 : 0);
        let dy: i64 = direction == 2 ? -1 : (direction == 3 ? 1 : 0);
        let left: i64 = brick_left(g, index) / 1000 + dx;
        let top: i64 = brick_top(g, index) / 1000 + dy;
        // One-cell cardinal steps cannot cross another brick if both the
        // starting and destination rectangles are clear.
        if brick_space_free(g, index, left, top) {
            set_brick(&mut g.party_x, index, left - (index % 12 * 5 + g.brick_shift_x));
            set_brick(&mut g.party_y, index, top - (index / 12 + 2 + g.brick_shift_y));
        }
    }
    let level: i64 = chaos_level(g);
    g.party_step_ticks = level < 4 ? 4 - level : 0;
}

fn reset_lsd(g: &mut Game) -> void {
    reset_party(&mut g);
    g.lsd_ticks = 0;
    g.lsd_doses = 0;
    g.glow_phase = 0;
    g.glow_direction = 1;
    g.glow_turn_ticks = 0;
    g.lsd_step_ticks = 0;
    g.lsd_control_ticks = 0;
    g.lsd_mistake_ticks = 0;
    g.lsd_mistake = 0;
    g.brick_shift_x = 0;
    g.brick_shift_y = 0;
    g.brick_drift_x = 1;
    g.brick_drift_y = 1;
}

pub fn confine_bricks(g: &mut Game) -> void {
    if g.party_active { return; }
    var left: i64 = 60;
    var right: i64 = 0;
    for i in 0..60 {
        if g.bricks[i] > 0 {
            let x: i64 = i % 12 * 5;
            if x < left { left = x; }
            if x + 4 > right { right = x + 4; }
        }
    }
    if left == 60 { return; }
    g.brick_shift_x = clamp(g.brick_shift_x, -left, 60 - right);
    // Leave the formation above even the highest point of a tilted pad.
    let raised: bool = paddle_angle(g) != 0 || paddle_vertical(g);
    let floor: i64 = raised ? (g.expand_ticks > 0 ? 1 : 3) : 5;
    g.brick_shift_y = clamp(g.brick_shift_y, -2, floor);
}

pub fn tick_lsd(g: &mut Game) -> void {
    if g.lsd_ticks == 0 { return; }
    g.lsd_ticks -= 1;
    if g.lsd_ticks == 0 { reset_lsd(&mut g); return; }
    if g.glow_turn_ticks > 0 { g.glow_turn_ticks -= 1; }
    else {
        g.glow_seed = g.glow_seed * 48271 % 2147483647;
        g.glow_direction = g.glow_seed % 2 == 0 ? -1 : 1;
        g.glow_turn_ticks = 90 + g.glow_seed % 160;
    }
    g.glow_phase = (g.glow_phase + g.glow_direction * 3 + 1536) % 1536;
    if g.lsd_mistake_ticks > 0 { g.lsd_mistake_ticks -= 1; }
    if g.lsd_control_ticks > 0 { g.lsd_control_ticks -= 1; }
    else {
        g.lsd_seed = g.lsd_seed * 48271 % 2147483647;
        if g.lsd_seed % 4 == 0 {
            g.lsd_mistake = 1 + g.lsd_seed / 4 % 4;
            g.lsd_mistake_ticks = 10 + g.lsd_seed % 11;
        }
        g.lsd_control_ticks = 50 + g.lsd_seed / 11 % 60;
    }
    if g.xtc_ticks == 0 {
        if g.lsd_step_ticks > 0 { g.lsd_step_ticks -= 1; }
        else {
            if g.lsd_ticks <= 125 {
                // Bring the layout home during the final second rather than teleport.
                if g.brick_shift_x != 0 { g.brick_shift_x += g.brick_shift_x < 0 ? 1 : -1; }
                if g.brick_shift_y != 0 { g.brick_shift_y += g.brick_shift_y < 0 ? 1 : -1; }
                g.lsd_step_ticks = 8;
            } else {
                g.lsd_seed = g.lsd_seed * 48271 % 2147483647;
                if g.lsd_seed % 3 == 0 { g.brick_drift_x = -g.brick_drift_x; }
                if g.lsd_seed / 3 % 3 == 0 { g.brick_drift_y = -g.brick_drift_y; }
                let x: i64 = g.brick_shift_x + g.brick_drift_x;
                let y: i64 = g.brick_shift_y + g.brick_drift_y;
                g.brick_shift_x = x;
                g.brick_shift_y = y;
                confine_bricks(&mut g);
                if g.brick_shift_x != x { g.brick_drift_x = -g.brick_drift_x; }
                if g.brick_shift_y != y { g.brick_drift_y = -g.brick_drift_y; }
                g.lsd_step_ticks = 35 + g.lsd_seed % 35;
            }
        }
    }
    confine_bricks(&mut g);
}

pub fn lsd_input(g: &Game, direction: i64) -> i64 {
    if g.lsd_ticks == 0 || g.lsd_mistake_ticks == 0 { return direction; }
    if g.lsd_mistake == 1 { return 0; }
    if g.lsd_mistake == 2 { return -direction; }
    return g.lsd_mistake == 3 ? -1 : 1;
}

struct BoxContact { var time: i64; var normal: i64; };

fn box_contact(old_x: i64, old_y: i64, x: i64, y: i64,
                 old_left: i64, old_top: i64, left: i64, top: i64, width: i64, height: i64) -> BoxContact {
    // Swept point/AABB collision in the moving brick's frame of reference.
    let start_x: i64 = old_x - old_left;
    let start_y: i64 = old_y - old_top;
    let dx: i64 = x - left - start_x;
    let dy: i64 = y - top - start_y;
    var enter_x: i64 = -1000000000;
    var exit_x: i64 = 1000000000;
    var enter_y: i64 = -1000000000;
    var exit_y: i64 = 1000000000;
    if dx == 0 {
        if start_x < 0 || start_x >= width { return BoxContact { time: -1, normal: 0 }; }
    } else if dx > 0 {
        enter_x = -start_x * 1000000 / dx;
        exit_x = (width - start_x) * 1000000 / dx;
    } else {
        enter_x = (width - start_x) * 1000000 / dx;
        exit_x = -start_x * 1000000 / dx;
    }
    if dy == 0 {
        if start_y < 0 || start_y >= height { return BoxContact { time: -1, normal: 0 }; }
    } else if dy > 0 {
        enter_y = -start_y * 1000000 / dy;
        exit_y = (height - start_y) * 1000000 / dy;
    } else {
        enter_y = (height - start_y) * 1000000 / dy;
        exit_y = -start_y * 1000000 / dy;
    }
    let enter: i64 = enter_x > enter_y ? enter_x : enter_y;
    let leave: i64 = exit_x < exit_y ? exit_x : exit_y;
    if enter < 0 || enter > leave || leave < 0 || enter > 1000000 { return BoxContact { time: -1, normal: 0 }; }
    let normal: i64 = enter_x > enter_y ? (dx > 0 ? -1 : 1) : (dy > 0 ? -2 : 2);
    return BoxContact { time: enter < 0 ? 0 : enter, normal: normal };
}

pub fn clear_powerups(g: &mut Game) -> void {
    let was_vertical: bool = paddle_vertical(g);
    let center: i64 = g.paddle + paddle_width(g) / 2;
    g.xtc_ticks = 0;
    g.xtc_doses = 0;
    g.xtc_phase = 0;
    g.vertical_ticks = 0;
    g.vertical_direction = 1;
    reset_lsd(&mut g);
    g.mla_ticks = 0;
    g.expand_ticks = 0;
    g.slow_ticks = 0;
    g.catch_ticks = 0;
    g.scatter_ticks = 0;
    g.hole_ticks = 0;
    g.fast_ticks = 0;
    g.side_shot = false;
    g.angle_ticks = 0;
    g.angle_direction = 1;
    g.paddle = clamp(was_vertical ? center - 4000 : g.paddle, 0, 52000);
    for i in 0..8 { set_brick(&mut g.drop_kind, i, 0); }
}

pub fn spawn_capsule(g: &mut Game, kind: i64, x: i64, y: i64) -> void {
    for i in 0..8 {
        if g.drop_kind[i] == 0 {
            set_brick(&mut g.drop_kind, i, kind);
            set_brick(&mut g.drop_x, i, kind == 6 ? clamp(x, 2000, 56000) : ((kind == 5 || kind == 11 || kind == 13) ? clamp(x, 2000, 57000) : x));
            set_brick(&mut g.drop_y, i, y);
            return;
        }
    }
}

pub fn collect_capsule(g: &mut Game, kind: i64) -> void {
    if kind == 1 {
        // Grow around the paddle center, respecting both walls.
        if g.expand_ticks == 0 && g.mla_ticks == 0 && !paddle_vertical(g) { g.paddle = clamp(g.paddle - 2000, 0, 48000); }
        g.expand_ticks = 1500;
    }
    if kind == 2 { g.slow_ticks = 1250; }
    if kind == 3 { g.catch_ticks = 1500; }
    if kind == 4 { g.lives = clamp(g.lives + 1, 0, 5); }
    if kind == 5 {
        g.mla_ticks = 1250;
        g.paddle = 0;
        g.velocity = 0;
    }
    if kind == 6 {
        for i in 0..60 { set_brick(&mut g.bricks, i, 0); }
        g.remaining = 0;
        g.blast_ticks = 100;
    }
    if kind == 7 {
        g.angle_ticks = 1500;
        g.angle_direction = g.velocity < 0 ? -1 : 1;
    }
    if kind == 8 {
        g.scatter_ticks = 1500;
        g.direction_seed = (g.score * 31 + g.broken * 17 + g.paddle) % 2147483646 + 1;
    }
    if kind == 9 { g.hole_ticks = 1500; }
    if kind == 10 { g.fast_ticks = 1250; }
    if kind == 11 {
        let was_active: bool = g.lsd_ticks > 0;
        g.lsd_doses = was_active ? clamp(g.lsd_doses + 1, 1, 8) : 1;
        g.lsd_ticks = lsd_duration_ticks();
        g.lsd_seed = (g.score * 17 + g.paddle + g.broken * 31) % 2147483646 + 1;
        g.glow_seed = g.lsd_seed * 48271 % 2147483647;
        if !was_active { g.glow_phase = g.glow_seed % 1536; }
        g.glow_direction = g.glow_seed % 2 == 0 ? -1 : 1;
        g.glow_turn_ticks = 90 + g.glow_seed % 160;
        g.lsd_step_ticks = 0;
        g.lsd_control_ticks = 0;
    }
    if kind == 12 {
        let center: i64 = g.paddle + paddle_width(g) / 2;
        g.vertical_ticks = 1500;
        g.vertical_direction = g.velocity < 0 ? -1 : 1;
        g.paddle = clamp(center - paddle_width(g) / 2, 0, 60000 - paddle_width(g));
    }
    if kind == 13 {
        g.xtc_doses = g.xtc_ticks > 0 ? clamp(g.xtc_doses + 1, 1, 8) : 1;
        if g.xtc_ticks == 0 { g.xtc_phase = 0; }
        g.xtc_ticks = xtc_duration_ticks();
    }
    if (kind == 11 || kind == 13) && chaos_level(g) > 0 {
        g.chaos_seed = (g.score * 19 + g.paddle + g.lsd_doses * 31 + g.xtc_doses * 43) % 2147483646 + 1;
        let interval: i64 = chaos_interval(g);
        if g.chaos_kick_ticks > interval { g.chaos_kick_ticks = interval; }
    }
    award_points(&mut g, 100);
}

pub fn tick_capsules(g: &mut Game) -> void {
    var missed_x: bool = false;
    for i in 0..8 {
        if g.drop_kind[i] > 0 {
            let old_y: i64 = g.drop_y[i];
            let y: i64 = old_y + 24; // Three terminal rows per second.
            set_brick(&mut g.drop_y, i, y);
            let surface: i64 = paddle_surface(g, g.drop_x[i]);
            if old_y < surface && y >= surface &&
               g.drop_x[i] >= g.paddle - 500 &&
               g.drop_x[i] <= g.paddle + paddle_width(g) + 500 &&
               !paddle_hole(g, g.drop_x[i]) {
                let kind: i64 = g.drop_kind[i];
                set_brick(&mut g.drop_kind, i, 0);
                collect_capsule(&mut g, kind);
                if kind == 6 { break; }
            } else if y >= 16000 {
                if g.drop_kind[i] == 14 { missed_x = true; }
                set_brick(&mut g.drop_kind, i, 0);
            }
        }
    }
    if missed_x {
        g.score = 0;
        g.combo = 0;
        g.score_reset_ticks = 125;
    }
}

pub fn capsule_at(g: &Game, x: i64, y: i64) -> i64 {
    for i in 0..8 {
        let offset: i64 = x - g.drop_x[i] / 1000;
        let left: i64 = (g.drop_kind[i] == 5 || g.drop_kind[i] == 6 || g.drop_kind[i] == 11 || g.drop_kind[i] == 13) ? -2 : -1;
        let right: i64 = g.drop_kind[i] == 6 ? 3 : ((g.drop_kind[i] == 5 || g.drop_kind[i] == 11 || g.drop_kind[i] == 13) ? 2 : 1);
        if g.drop_kind[i] > 0 && g.drop_y[i] / 1000 == y &&
           offset >= left && offset <= right { return i; }
    }
    return -1;
}

pub fn serve(g: &mut Game) -> void {
    clear_powerups(&mut g);
    g.ready = true;
    g.ball_x = g.paddle + 4000;
    g.ball_y = 13500;
    g.ball_vx = 13000;
    g.ball_vy = -9500 - clamp(g.level - 1, 0, 8) * 700;
    g.combo = 0;
}

pub fn level_name(level: i64) -> str8 {
    let layout: i64 = (level - 1) % 8;
    if layout == 0 { return "PRISM WALL"; }
    if layout == 1 { return "NEON WINDOWS"; }
    if layout == 2 { return "FIRE CHEVRON"; }
    if layout == 3 { return "ICE DIAMOND"; }
    if layout == 4 { return "CHECKER POP"; }
    if layout == 5 { return "COLOR PILLARS"; }
    if layout == 6 { return "FORTRESS"; }
    return "SPACE INVADER";
}

pub fn brick_hp(level: i64, index: i64) -> i64 {
    let row: i64 = index / 12;
    let col: i64 = index % 12;
    let layout: i64 = (level - 1) % 8;
    var occupied: bool = true;
    if layout == 1 { occupied = (index + row) % 5 != 0; }
    if layout == 2 { occupied = col >= row && col < 12 - row; }
    if layout == 3 { occupied = magnitude(col * 2 - 11) + magnitude(row * 2 - 4) * 2 <= 11; }
    if layout == 4 { occupied = (col / 2 + row) % 2 == 0; }
    if layout == 5 { occupied = col % 3 != 1; }
    if layout == 6 {
        occupied = row == 0 || row == 4 || col == 0 || col == 11 ||
                   (row == 2 && col >= 3 && col <= 8);
    }
    if layout == 7 {
        if row == 0 { occupied = col == 2 || col == 3 || col == 8 || col == 9; }
        if row == 1 { occupied = col == 3 || col == 8; }
        if row == 2 { occupied = col >= 2 && col <= 9; }
        if row == 3 { occupied = col == 1 || col == 2 || (col >= 4 && col <= 7) || col == 9 || col == 10; }
        if row == 4 { occupied = col == 1 || col == 2 || col == 4 || col == 7 || col == 9 || col == 10; }
    }
    if !occupied { return 0; }
    if level > 16 && row == 0 { return 3; }
    return level > 1 && row == 0 ? 2 : 1;
}

pub fn fill_wave(g: &mut Game) -> void {
    g.remaining = 0;
    for i in 0..60 {
        let hp: i64 = brick_hp(g.level, i);
        set_brick(&mut g.bricks, i, hp);
        if hp > 0 { g.remaining += 1; }
    }
    serve(&mut g);
}

pub fn advance_wave(g: &mut Game) -> void {
    g.level += 1;
    award_points(&mut g, 500);
    fill_wave(&mut g);
}

pub fn new_game(best: i64) -> Game {
    var bricks: list<i64> = [];
    for i in 0..60 { bricks.push(1); }
    return Game {
        bricks: bricks,
        party_x: brick_offsets(), party_y: brick_offsets(),
        previous_brick_x: brick_offsets(), previous_brick_y: brick_offsets(),
        party_active: false, party_step_ticks: 0, party_seed: 107,
        drop_kind: empty_slots(), drop_x: empty_slots(), drop_y: empty_slots(),
        broken: 0, blast_ticks: 0, mla_ticks: 0, expand_ticks: 0, slow_ticks: 0, catch_ticks: 0, scatter_ticks: 0, hole_ticks: 0, fast_ticks: 0, xtc_rate: 10, lsd_doses: 0, xtc_doses: 0, chaos_kick_ticks: 0, chaos_seed: 113, xtc_ticks: 0, xtc_phase: 0, lsd_rate: 10, drop_seed: 97, glow_phase: 0, glow_direction: 1, glow_turn_ticks: 0, glow_seed: 101, lsd_ticks: 0, lsd_seed: 97, lsd_step_ticks: 0, lsd_control_ticks: 0, lsd_mistake_ticks: 0, lsd_mistake: 0, brick_shift_x: 0, brick_shift_y: 0, brick_drift_x: 1, brick_drift_y: 1, direction_seed: 73, side_shot: false, vertical_ticks: 0, vertical_direction: 1, angle_ticks: 0, angle_direction: 1, paddle: 26000, velocity: 0,
        ball_x: 30000, ball_y: 13500, ball_vx: 13000, ball_vy: -9500,
        score_reset_ticks: 0, score: 0, best: best, lives: 3, level: 1, remaining: 60, combo: 0,
        ready: true, paused: false, over: false,
        flash_x: -1, flash_y: -1, flash_ticks: 0
    };
}

pub fn new_game_with_rates(best: i64, lsd_rate: i64, xtc_rate: i64) -> Game {
    var g: Game = new_game(best);
    g.lsd_rate = clamp(lsd_rate, 0, 100);
    g.xtc_rate = clamp(xtc_rate, 0, 100 - g.lsd_rate);
    return g;
}

pub fn new_game_with_rate(best: i64, lsd_rate: i64) -> Game {
    return new_game_with_rates(best, lsd_rate, 10);
}

pub fn launch(g: &mut Game) -> void {
    if !g.over && !g.paused {
        if g.ready && paddle_vertical(g) {
            let speed: i64 = integer_sqrt((g.ball_vx / 2) * (g.ball_vx / 2) + g.ball_vy * g.ball_vy);
            g.ball_vx = g.vertical_direction * speed * 2;
            g.ball_vy = 0;
            g.side_shot = true;
        }
        g.ready = false;
    }
}

pub fn step_paddle(g: &mut Game, direction: i64) -> void {
    if direction != 0 { g.vertical_direction = direction < 0 ? -1 : 1; }
    if g.angle_ticks > 0 && direction != 0 { g.angle_direction = direction < 0 ? -1 : 1; }
    if g.mla_ticks > 0 { g.paddle = 0; g.velocity = 0; return; }
    if direction != 0 {
        // Acceleration: 90 cells/s², capped at 36 cells/s.
        g.velocity = clamp(g.velocity + direction * 720, -36000, 36000);
    } else {
        g.velocity = g.velocity * 85 / 100;
        if magnitude(g.velocity) < 150 { g.velocity = 0; }
    }
    g.paddle += g.velocity * 8 / 1000;
    if g.paddle < 0 { g.paddle = 0; g.velocity = 0; }
    let limit: i64 = 60000 - paddle_width(g);
    if g.paddle > limit { g.paddle = limit; g.velocity = 0; }
}

pub fn tick(g: &mut Game, direction: i64) -> void {
    if g.paused || g.over { return; }
    if g.score_reset_ticks > 0 { g.score_reset_ticks -= 1; }
    for i in 0..60 {
        let left: i64 = brick_left(g, i);
        let top: i64 = brick_top(g, i);
        set_brick(&mut g.previous_brick_x, i, left);
        set_brick(&mut g.previous_brick_y, i, top);
    }
    let old_paddle: i64 = g.paddle;
    let old_width: i64 = paddle_width(g);
    let old_height: i64 = paddle_height(g);
    let old_angle: i64 = paddle_angle(g);
    if g.xtc_ticks > 0 {
        g.xtc_ticks -= 1;
        g.xtc_phase = g.xtc_ticks > 0 ? (g.xtc_phase + 1) % 200 : 0;
        if g.xtc_ticks == 0 { g.xtc_doses = 0; }
    }
    if g.vertical_ticks > 0 { g.vertical_ticks -= 1; }
    if g.scatter_ticks > 0 { g.scatter_ticks -= 1; }
    if g.hole_ticks > 0 { g.hole_ticks -= 1; }
    if g.fast_ticks > 0 { g.fast_ticks -= 1; }
    if g.angle_ticks > 0 { g.angle_ticks -= 1; }
    if g.mla_ticks > 0 {
        g.mla_ticks -= 1;
    }
    if g.expand_ticks > 0 {
        g.expand_ticks -= 1;
    }
    if paddle_width(g) != old_width {
        g.paddle = clamp(old_paddle + old_width / 2 - paddle_width(g) / 2, 0, 60000 - paddle_width(g));
    }
    if g.slow_ticks > 0 { g.slow_ticks -= 1; }
    if g.catch_ticks > 0 { g.catch_ticks -= 1; }
    tick_lsd(&mut g);
    tick_party_bricks(&mut g);
    let control: i64 = lsd_input(g, direction);
    step_paddle(&mut g, control);
    if g.blast_ticks > 0 { g.blast_ticks -= 1; }
    tick_capsules(&mut g);
    if g.lsd_ticks > 0 { confine_bricks(&mut g); }
    if g.remaining == 0 { advance_wave(&mut g); return; }
    if g.flash_ticks > 0 { g.flash_ticks -= 1; }
    if g.ready {
        g.ball_x = paddle_rest_x(g);
        g.ball_y = paddle_surface(g, g.ball_x) - 500;
        return;
    }
    tick_chaos_ball(&mut g);
    let old_x: i64 = g.ball_x;
    let old_y: i64 = g.ball_y;
    let speed_percent: i64 = (g.slow_ticks > 0 ? 65 : 100) * (g.fast_ticks > 0 ? 2 : 1);
    g.ball_x += g.ball_vx * 8 * speed_percent / 100000;
    g.ball_y += g.ball_vy * 8 * speed_percent / 100000;
    var side_wall_hit: bool = false;
    if g.ball_x < 0 { g.ball_x = -g.ball_x; g.ball_vx = magnitude(g.ball_vx); side_wall_hit = true; }
    if g.ball_x >= 60000 {
        g.ball_x = 119998 - g.ball_x;
        g.ball_vx = -magnitude(g.ball_vx);
        side_wall_hit = true;
    }
    if g.side_shot && side_wall_hit {
        let speed: i64 = diagonal_speed(g.ball_vx, 0);
        g.ball_vx = g.ball_vx < 0 ? -speed * 2 : speed * 2;
        g.ball_vy = -speed;
        g.side_shot = false;
    }
    if g.ball_y < 0 { g.ball_y = -g.ball_y; g.ball_vy = magnitude(g.ball_vy); }

    if paddle_vertical(g) {
        let top: i64 = paddle_top(g);
        let height: i64 = paddle_height(g);
        let previous_top: i64 = old_height > 0 ? 14000 - old_height : top;
        let previous_height: i64 = old_height > 0 ? old_height : height;
        let segments: i64 = g.hole_ticks > 0 ? 2 : 1;
        var first_time: i64 = 1000001;
        var normal: i64 = 0;
        var segment_top: i64 = top;
        var segment_height: i64 = height;
        for segment in 0..segments {
            let part_top: i64 = segment == 0 ? top : top + height / 2 + 1000;
            let old_top: i64 = segment == 0 ? previous_top : previous_top + previous_height / 2 + 1000;
            let part_height: i64 = segments == 1 ? height : (height - 2000) / 2;
            let contact: BoxContact = box_contact(old_x, old_y, g.ball_x, g.ball_y,
                old_height > 0 ? old_paddle : g.paddle, old_top,
                g.paddle, part_top, 1000, part_height);
            if contact.time >= 0 && contact.time < first_time {
                first_time = contact.time;
                normal = contact.normal;
                segment_top = part_top;
                segment_height = part_height;
            }
        }
        if normal != 0 {
            let hit_y: i64 = old_y + (g.ball_y - old_y) * first_time / 1000000;
            let speed: i64 = integer_sqrt((g.ball_vx / 2) * (g.ball_vx / 2) + g.ball_vy * g.ball_vy);
            g.side_shot = false;
            if normal == -2 || (magnitude(normal) == 1 && hit_y < segment_top + 500) {
                // Upper caps always return the ball to the brick field.
                g.ball_y = segment_top - 1;
                g.ball_vx = 0;
                g.ball_vy = -speed;
            } else if magnitude(normal) == 1 {
                g.ball_x = normal < 0 ? g.paddle - 1 : g.paddle + 1001;
                g.ball_vx = normal * speed * 2;
                g.ball_vy = 0;
                g.side_shot = true;
            } else {
                g.ball_y = segment_top + segment_height;
                g.ball_vx = 0;
                g.ball_vy = speed;
            }
            g.combo = 0;
            if g.catch_ticks > 0 {
                g.ready = true;
                g.ball_x = paddle_rest_x(g);
                g.ball_y = top - 500;
            }
        }
    } else {
        // Sweep against the actual surface, including paddle motion and lean.
        // Check the crossing point rather than the end position to avoid tunneling.
        let before: i64 = old_y - surface_at(old_paddle, old_width, old_angle, old_x);
        let after: i64 = g.ball_y - paddle_surface(g, g.ball_x);
        if before < 0 && after >= 0 {
            let fraction: i64 = -before * 1000000 / (after - before);
            let hit_x: i64 = old_x + (g.ball_x - old_x) * fraction / 1000000;
            let hit_left: i64 = old_paddle + (g.paddle - old_paddle) * fraction / 1000000;
            let hit_width: i64 = old_width + (paddle_width(g) - old_width) * fraction / 1000000;
            if hit_x >= hit_left - 350 && hit_x <= hit_left + hit_width + 350 &&
               !(g.hole_ticks > 0 && hole_at(hit_left, hit_width, hit_x)) {
                let surface: i64 = paddle_surface(g, g.ball_x);
                g.side_shot = false;
                if g.scatter_ticks > 0 {
                    scatter_rebound(&mut g);
                    g.ball_y = surface - 100;
                } else if paddle_angle(g) != 0 {
                    let speed: i64 = diagonal_speed(g.ball_vx, g.ball_vy);
                    g.ball_vx = paddle_angle(g) * speed * 2;
                    g.ball_vy = -speed;
                    g.ball_y = surface - 100;
                } else {
                    let offset: i64 = (g.ball_x - g.paddle - paddle_width(g) / 2) * 8000 / paddle_width(g);
                    g.ball_vx = clamp(offset * 5 + g.velocity / 4, -26000, 26000);
                    if magnitude(g.ball_vx) < 4500 { g.ball_vx = offset < 0 ? -4500 : 4500; }
                    g.ball_vy = -magnitude(g.ball_vy);
                    g.ball_y = surface * 2 - 1 - g.ball_y;
                }
                g.combo = 0;
                if g.catch_ticks > 0 {
                    g.ready = true;
                    g.ball_x = paddle_rest_x(g);
                    g.ball_y = paddle_surface(g, g.ball_x) - 500;
                }
            }
        }
    }

    // Find the first contact along the ball and brick motion this timestep.
    var hit_index: i64 = -1;
    var hit_time: i64 = 1000001;
    var hit_normal: i64 = 0;
    for i in 0..60 {
        if g.bricks[i] > 0 {
            let contact: BoxContact = box_contact(old_x, old_y, g.ball_x, g.ball_y,
                g.previous_brick_x[i], g.previous_brick_y[i],
                brick_left(g, i), brick_top(g, i), 4000, 1000);
            if contact.time >= 0 && contact.time < hit_time {
                hit_index = i;
                hit_time = contact.time;
                hit_normal = contact.normal;
            }
        }
    }
    if hit_index >= 0 {
        let hp: i64 = g.bricks[hit_index] - 1;
        set_brick(&mut g.bricks, hit_index, hp);
        let left: i64 = brick_left(g, hit_index);
        let top: i64 = brick_top(g, hit_index);
        g.flash_x = left / 1000 + 1;
        g.flash_y = top / 1000;
        g.flash_ticks = 14;
        if magnitude(hit_normal) == 1 {
            g.ball_x = hit_normal < 0 ? left - 1 : left + 4000;
            let speed: i64 = magnitude(g.ball_vx) < 4500 ? 4500 : magnitude(g.ball_vx);
            g.ball_vx = hit_normal < 0 ? -speed : speed;
        } else {
            g.ball_y = hit_normal < 0 ? top - 1 : top + 1000;
            let speed: i64 = magnitude(g.ball_vy) < 4500 ? 4500 : magnitude(g.ball_vy);
            g.ball_vy = hit_normal < 0 ? -speed : speed;
        }
        if hp == 0 {
            g.broken += 1;
            if g.broken % 3 == 0 {
                let kind: i64 = capsule_for_break(&mut g);
                spawn_capsule(&mut g, kind, left + 2000, top + 500);
            }
            g.remaining -= 1;
            g.combo += 1;
            let points: i64 = (5 - hit_index / 12) * 10 * clamp(g.combo, 1, 8);
            award_points(&mut g, points);
        } else { award_points(&mut g, 5); }
    }
    if g.remaining == 0 {
        advance_wave(&mut g);
    } else if g.ball_y >= 16000 {
        clear_powerups(&mut g);
        g.lives -= 1;
        g.velocity = 0;
        if g.lives == 0 { g.over = true; } else { serve(&mut g); }
    }
}
