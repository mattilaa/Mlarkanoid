mod game;
mod std::testing;
mod std::strbuf;
use std::strbuf::StringBuilder;
use game::*;
use std::testing::verify;

fn put(bricks: &mut list<i64>, index: i64, hp: i64) -> void {
    bricks[index] = hp;
}

#[test]
fn test_paddle_accelerates_brakes_and_reverses() {
    var g: Game = new_game(0);
    tick(&mut g, 1);
    let initial: i64 = g.velocity;
    for i in 0..12 { tick(&mut g, 1); }
    verify(g.velocity > initial && g.paddle > 26000);
    let fast: i64 = g.velocity;
    tick(&mut g, 0);
    verify(g.velocity < fast && g.velocity > 0);
    for i in 0..30 { tick(&mut g, -1); }
    verify(g.velocity < 0);
}

#[test]
fn test_paddle_speed_cap_and_both_boundaries() {
    var g: Game = new_game(0);
    g.paddle = 10000;
    for i in 0..50 { tick(&mut g, 1); }
    verify(g.velocity == 36000);
    for i in 0..300 { tick(&mut g, 1); }
    verify(g.paddle == 52000 && g.velocity == 0);
    for i in 0..400 { tick(&mut g, -1); }
    verify(g.paddle == 0 && g.velocity == 0);
}

#[test]
fn test_ball_follows_paddle_until_launched() {
    var g: Game = new_game(0);
    for i in 0..20 { tick(&mut g, -1); }
    verify(g.ball_x == g.paddle + 4000 && g.ball_y == 13500);
    launch(&mut g);
    tick(&mut g, 0);
    verify(!g.ready && g.ball_y < 13500);
}

#[test]
fn test_walls_reflect_ball_inward() {
    var g: Game = new_game(0);
    g.ready = false;
    g.ball_x = 59990;
    g.ball_y = 10000;
    g.ball_vx = 20000;
    tick(&mut g, 0);
    verify(g.ball_x < 60000 && g.ball_vx < 0);
    g.ball_x = 10;
    g.ball_vx = -20000;
    tick(&mut g, 0);
    verify(g.ball_x >= 0 && g.ball_vx > 0);
    g.ball_x = 4500;
    g.ball_y = 5;
    g.ball_vy = -10000;
    tick(&mut g, 0);
    verify(g.ball_y >= 0 && g.ball_vy > 0);
}

#[test]
fn test_paddle_impact_adds_angle_and_resets_combo() {
    var g: Game = new_game(0);
    g.ready = false;
    g.ball_x = g.paddle + 7500;
    g.ball_y = 13980;
    g.ball_vx = 0;
    g.ball_vy = 10000;
    g.combo = 4;
    tick(&mut g, 0);
    verify(g.ball_vy < 0 && g.ball_vx > 0 && g.combo == 0);
}

#[test]
fn test_destroyed_brick_scores_and_reflects() {
    var g: Game = new_game(0);
    g.ready = false;
    g.ball_x = 1500;
    g.ball_y = 7020;
    g.ball_vx = 0;
    g.ball_vy = -10000;
    tick(&mut g, 0);
    verify(g.bricks[48] == 0 && g.remaining == 59);
    verify(g.score == 10 && g.best == 10 && g.combo == 1);
    verify(g.ball_vy > 0);
}

#[test]
fn test_side_impact_reflects_horizontally() {
    var g: Game = new_game(0);
    g.ready = false;
    g.ball_x = 4050;
    g.ball_y = 6500;
    g.ball_vx = -20000;
    g.ball_vy = 0;
    tick(&mut g, 0);
    verify(g.ball_vx > 0 && g.bricks[48] == 0);
}

#[test]
fn test_armored_brick_takes_two_hits() {
    var g: Game = new_game(0);
    put(&mut g.bricks, 48, 2);
    g.ready = false;
    g.ball_x = 1500;
    g.ball_y = 7020;
    g.ball_vx = 0;
    g.ball_vy = -10000;
    tick(&mut g, 0);
    verify(g.bricks[48] == 1 && g.remaining == 60 && g.score == 5);
    g.ball_y = 7020;
    g.ball_vy = -10000;
    tick(&mut g, 0);
    verify(g.bricks[48] == 0 && g.remaining == 59 && g.score == 15);
}

#[test]
fn test_gutter_does_not_hit_neighboring_bricks() {
    var g: Game = new_game(0);
    g.ready = false;
    g.ball_x = 4500;
    g.ball_y = 7020;
    g.ball_vx = 0;
    g.ball_vy = -10000;
    tick(&mut g, 0);
    verify(g.remaining == 60 && g.ball_vy < 0);
}

#[test]
fn test_last_brick_advances_wave_and_waits_for_serve() {
    var g: Game = new_game(0);
    for i in 0..60 { put(&mut g.bricks, i, 0); }
    put(&mut g.bricks, 48, 1);
    g.remaining = 1;
    g.ready = false;
    g.ball_x = 1500;
    g.ball_y = 7020;
    g.ball_vx = 0;
    g.ball_vy = -10000;
    tick(&mut g, 0);
    verify(g.level == 2 && g.ready && g.remaining == 48);
    verify(g.score == 510 && g.best == 510);
    verify(g.bricks[1] == 2);
}

#[test]
fn test_miss_costs_life_and_final_miss_ends_game() {
    var g: Game = new_game(0);
    g.ready = false;
    g.ball_y = 15999;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.lives == 2 && g.ready && !g.over);
    g.lives = 1;
    g.ready = false;
    g.ball_y = 15999;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.lives == 0 && g.over);
    let x: i64 = g.paddle;
    tick(&mut g, 1);
    verify(g.paddle == x);
}

#[test]
fn test_pause_freezes_physics_and_blocks_launch() {
    var g: Game = new_game(1234);
    g.paused = true;
    launch(&mut g);
    tick(&mut g, 1);
    verify(g.ready && g.paddle == 26000 && g.best == 1234);
}

#[test]
fn test_capsules_spawn_on_destruction_and_cycle_through_specials() {
    var g: Game = new_game(0);
    g.ready = false;
    g.broken = 2;
    g.ball_x = 1500;
    g.ball_y = 7020;
    g.ball_vx = 0;
    g.ball_vy = -10000;
    tick(&mut g, 0);
    verify(g.drop_kind[0] == 1 && g.drop_x[0] == 2000);
    verify(g.drop_y[0] == 6500);
    clear_powerups(&mut g);
    put(&mut g.bricks, 48, 2);
    g.broken = 14;
    g.ball_y = 7020;
    g.ball_vy = -10000;
    tick(&mut g, 0);
    verify(g.broken == 14 && g.drop_kind[0] == 0);
    g.ball_y = 7020;
    g.ball_vy = -10000;
    tick(&mut g, 0);
    verify(g.drop_kind[0] == 5);
    clear_powerups(&mut g);
    put(&mut g.bricks, 48, 1);
    g.broken = 17;
    g.ball_y = 7020;
    g.ball_vy = -10000;
    tick(&mut g, 0);
    verify(g.drop_kind[0] == 6);
}

#[test]
fn test_capsules_fall_collect_and_misses_disappear() {
    var g: Game = new_game(0);
    spawn_capsule(&mut g, 1, 30000, 13990);
    tick(&mut g, 0);
    verify(g.drop_kind[0] == 0 && g.expand_ticks == 1500);
    verify(g.score == 100 && g.best == 100 && paddle_width(&g) == 12000);
    spawn_capsule(&mut g, 4, 2000, 13990);
    tick(&mut g, 0);
    verify(g.drop_y[0] == 14014 && g.lives == 3);
    for i in 0..90 { tick(&mut g, 0); }
    verify(g.drop_kind[0] == 0 && g.lives == 3);
}

#[test]
fn test_expand_refreshes_without_stacking_and_restores_center() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 1);
    verify(g.paddle == 24000 && paddle_width(&g) == 12000);
    collect_capsule(&mut g, 1);
    verify(g.paddle == 24000 && g.expand_ticks == 1500);
    g.expand_ticks = 1;
    tick(&mut g, 0);
    verify(g.paddle == 26000 && paddle_width(&g) == 8000);
    g.paddle = 52000;
    collect_capsule(&mut g, 1);
    verify(g.paddle == 48000);
    for i in 0..10 { tick(&mut g, 1); }
    verify(g.paddle + paddle_width(&g) <= 60000);
}

#[test]
fn test_expanded_paddle_catches_ball_outside_normal_width() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 1);
    g.ready = false;
    g.ball_x = 35000;
    g.ball_y = 13990;
    g.ball_vx = 0;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.ball_vy < 0 && g.lives == 3);
}

#[test]
fn test_slow_changes_motion_without_compounding_base_velocity() {
    var g: Game = new_game(0);
    g.ready = false;
    g.ball_x = 30000;
    g.ball_y = 10000;
    g.ball_vx = 10000;
    g.ball_vy = 10000;
    collect_capsule(&mut g, 2);
    collect_capsule(&mut g, 2);
    tick(&mut g, 0);
    verify(g.ball_x == 30052 && g.ball_y == 10052);
    verify(g.ball_vx == 10000 && g.ball_vy == 10000);
    g.slow_ticks = 1;
    tick(&mut g, 0);
    verify(g.ball_x == 30132 && g.ball_y == 10132);
}

#[test]
fn test_catch_holds_ball_until_space_launch() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 3);
    g.ready = false;
    g.ball_x = 30000;
    g.ball_y = 13990;
    g.ball_vx = 0;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.ready && g.ball_y == 13500);
    for i in 0..20 { tick(&mut g, 1); }
    verify(g.ball_x == g.paddle + paddle_width(&g) / 2);
    launch(&mut g);
    tick(&mut g, 0);
    verify(!g.ready && g.ball_y < 13500);
}

#[test]
fn test_extra_life_is_capped_at_five() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 4);
    verify(g.lives == 4);
    for i in 0..4 { collect_capsule(&mut g, 4); }
    verify(g.lives == 5);
}

#[test]
fn test_mla_covers_whole_arena_and_restores_expanded_paddle() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 1);
    collect_capsule(&mut g, 5);
    verify(g.paddle == 0 && paddle_width(&g) == 60000);
    for i in 0..30 { tick(&mut g, 1); }
    verify(g.paddle == 0 && g.velocity == 0);
    g.ready = false;
    g.ball_x = 59000;
    g.ball_y = 13990;
    g.ball_vx = 0;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.ball_vy < 0);
    g.mla_ticks = 1;
    tick(&mut g, 0);
    verify(paddle_width(&g) == 12000 && g.paddle == 24000);
}

#[test]
fn test_expand_expiring_during_mla_does_not_shift_full_paddle() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 5);
    collect_capsule(&mut g, 1);
    g.expand_ticks = 1;
    tick(&mut g, 0);
    verify(g.paddle == 0 && paddle_width(&g) == 60000);
    g.mla_ticks = 1;
    tick(&mut g, 0);
    verify(g.paddle == 26000 && paddle_width(&g) == 8000);
}

#[test]
fn test_nuke_collection_advances_wave_and_clears_effects() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 1);
    spawn_capsule(&mut g, 6, 30000, 13990);
    spawn_capsule(&mut g, 2, 2000, 5000);
    tick(&mut g, 0);
    verify(g.level == 2 && g.remaining == 48 && g.ready);
    verify(g.score == 700 && g.best == 700);
    verify(g.blast_ticks == 100 && g.expand_ticks == 0);
    verify(g.drop_kind[0] == 0 && g.drop_kind[1] == 0);
}

#[test]
fn test_large_capsules_fit_inside_arena_and_have_correct_widths() {
    var g: Game = new_game(0);
    spawn_capsule(&mut g, 5, 2000, 10000);
    verify(capsule_at(&g, 0, 10) == 0 && capsule_at(&g, 4, 10) == 0);
    verify(capsule_at(&g, 5, 10) == -1);
    spawn_capsule(&mut g, 6, 59000, 10000);
    verify(g.drop_x[1] == 56000);
    verify(capsule_at(&g, 54, 10) == 1 && capsule_at(&g, 59, 10) == 1);
}

#[test]
fn test_pause_freezes_capsules_timers_and_blast() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 5);
    spawn_capsule(&mut g, 2, 10000, 8000);
    g.blast_ticks = 50;
    g.paused = true;
    tick(&mut g, 1);
    verify(g.drop_y[0] == 8000 && g.mla_ticks == 1250 && g.blast_ticks == 50);
}

#[test]
fn test_life_loss_resets_all_temporary_effects_and_capsules() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 1);
    collect_capsule(&mut g, 2);
    collect_capsule(&mut g, 3);
    spawn_capsule(&mut g, 5, 30000, 8000);
    g.ready = false;
    g.ball_y = 15999;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.lives == 2 && g.ready);
    verify(g.expand_ticks == 0 && g.slow_ticks == 0 && g.catch_ticks == 0);
    verify(g.drop_kind[0] == 0 && paddle_width(&g) == 8000);
}

#[test]
fn test_eight_layouts_are_distinct_nonempty_and_repeat_with_armor() {
    var signatures: list<i64> = [];
    var g: Game = new_game(0);
    for level in 1..9 {
        g.level = level;
        fill_wave(&mut g);
        var count: i64 = 0;
        var signature: i64 = 0;
        for i in 0..60 {
            if g.bricks[i] > 0 { count += 1; signature += 1 << i; }
        }
        verify(count > 0 && count == g.remaining);
        for prior in signatures { verify(prior != signature); }
        signatures.push(signature);
    }
    for i in 0..60 { verify((brick_hp(1, i) > 0) == (brick_hp(9, i) > 0)); }
    verify(brick_hp(17, 0) == 3);
}

#[test]
fn test_angle_capsule_joins_drop_cycle_and_uses_a_small_tile() {
    var g: Game = new_game(0);
    g.broken = 20;
    g.ready = false;
    g.ball_x = 1500;
    g.ball_y = 7020;
    g.ball_vx = 0;
    g.ball_vy = -10000;
    tick(&mut g, 0);
    verify(g.drop_kind[0] == 7);
    verify(capsule_at(&g, 1, 6) == 0 && capsule_at(&g, 3, 6) == 0);
    verify(capsule_at(&g, 0, 6) == -1 && capsule_at(&g, 4, 6) == -1);
}

#[test]
fn test_angle_capsule_changes_the_visible_paddle_surface_and_lean() {
    var g: Game = new_game(0);
    spawn_capsule(&mut g, 7, 30000, 13990);
    tick(&mut g, 0);
    verify(g.angle_ticks == 1500 && paddle_angle(&g) == 1);
    verify(paddle_surface(&g, 26000) == 10000 && paddle_surface(&g, 34000) == 14000);
    verify(paddle_at(&g, 26, 10) && paddle_at(&g, 33, 13));
    verify(!paddle_at(&g, 30, 14));
    verify(g.ball_y == 11500 && g.score == 100);
    tick(&mut g, -1);
    verify(paddle_angle(&g) == -1);
    verify(paddle_surface(&g, g.paddle) == 14000);
    tick(&mut g, 1);
    verify(paddle_angle(&g) == 1);
}

#[test]
fn test_both_ramps_rebound_at_physical_45_degrees_and_preserve_speed() {
    for side in 0..2 {
        var g: Game = new_game(0);
        collect_capsule(&mut g, 7);
        g.angle_direction = side == 0 ? -1 : 1;
        g.ready = false;
        g.ball_x = 30000;
        g.ball_y = 11990;
        g.ball_vx = 0;
        g.ball_vy = 10000;
        tick(&mut g, 0);
        verify(g.ball_vy < 0);
        verify(g.ball_vx * g.angle_direction > 0);
        verify(magnitude(g.ball_vx) == magnitude(g.ball_vy) * 2);
        let squared_speed: i64 = (g.ball_vx / 2) * (g.ball_vx / 2) + g.ball_vy * g.ball_vy;
        verify(magnitude(squared_speed - 100000000) < 30000);
        verify(g.ball_y < paddle_surface(&g, g.ball_x));
    }
}

#[test]
fn test_ramp_collision_uses_its_height_not_the_old_flat_row() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 7);
    g.ready = false;
    g.ball_x = 27000;
    g.ball_y = 10490;
    g.ball_vx = 0;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.ball_vy < 0 && g.ball_y < 10500);
    // A ball already below the ramp must not hit an invisible horizontal pad.
    g.ball_x = 30000;
    g.ball_y = 13990;
    g.ball_vx = 0;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.ball_vy > 0 && g.ball_y > 14000);
    // A crossing beyond the finite ramp's endpoint must also miss.
    g.ball_x = 20000;
    g.ball_y = 6990;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.ball_vy > 0);
}

#[test]
fn test_catch_holds_and_releases_a_ball_above_the_ramp() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 7);
    collect_capsule(&mut g, 3);
    g.ready = false;
    g.ball_x = 30000;
    g.ball_y = 11990;
    g.ball_vx = 0;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.ready && g.ball_y == 11500);
    tick(&mut g, -1);
    verify(g.ball_y == paddle_surface(&g, g.ball_x) - 500);
    launch(&mut g);
    tick(&mut g, 0);
    verify(!g.ready && g.ball_vy < 0 && g.ball_x > g.paddle);
}

#[test]
fn test_capsules_are_collected_at_the_ramp_surface() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 7);
    spawn_capsule(&mut g, 4, 30000, 11990);
    tick(&mut g, 0);
    verify(g.lives == 4 && g.drop_kind[0] == 0);
}

#[test]
fn test_angle_effect_stacks_with_expand_and_is_suppressed_by_mla() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 1);
    collect_capsule(&mut g, 7);
    verify(paddle_width(&g) == 12000);
    verify(paddle_surface(&g, g.paddle) == 8000);
    verify(paddle_surface(&g, g.paddle + 12000) == 14000);
    collect_capsule(&mut g, 5);
    verify(paddle_angle(&g) == 0 && paddle_surface(&g, 10000) == 14000);
    g.mla_ticks = 1;
    tick(&mut g, 0);
    verify(paddle_angle(&g) == 1 && paddle_width(&g) == 12000);
    verify(g.ball_y == 10500);
}

#[test]
fn test_angle_timer_pause_expiry_and_wave_reset() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 7);
    g.paused = true;
    tick(&mut g, -1);
    verify(g.angle_ticks == 1500 && g.angle_direction == 1);
    g.paused = false;
    g.angle_ticks = 1;
    tick(&mut g, 0);
    verify(paddle_angle(&g) == 0 && g.ball_y == 13500);
    collect_capsule(&mut g, 7);
    fill_wave(&mut g);
    verify(g.angle_ticks == 0 && paddle_angle(&g) == 0);
    collect_capsule(&mut g, 7);
    g.ready = false;
    g.ball_y = 15999;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.lives == 2 && g.angle_ticks == 0);
}

#[test]
fn test_ramp_half_blocks_join_and_follow_the_physical_surface() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 7);
    // Backslash: top half then bottom half, across two columns per row.
    verify(std::strbuf::eq(paddle_glyph(&g, 26), "▀") == 1);
    verify(std::strbuf::eq(paddle_glyph(&g, 27), "▄") == 1);
    g.angle_direction = -1;
    verify(std::strbuf::eq(paddle_glyph(&g, 26), "▄") == 1);
    verify(std::strbuf::eq(paddle_glyph(&g, 27), "▀") == 1);
    // Fractional paddle motion must keep glyph halves aligned with collisions.
    g.paddle += 800;
    for x in 26..34 {
        let surface: i64 = paddle_surface(&g, x * 1000 + 500);
        let glyph: str8 = paddle_glyph(&g, x);
        verify(std::strbuf::eq(glyph, surface % 1000 < 500 ? "▀" : "▄") == 1);
        verify(paddle_at(&g, x, surface / 1000));
    }
}

#[test]
fn test_new_capsules_drop_in_sequence_and_keep_small_tiles() {
    for kind in 8..11 {
        var g: Game = new_game(0);
        g.broken = kind * 3 - 1;
        g.ready = false;
        g.ball_x = 1500;
        g.ball_y = 7020;
        g.ball_vx = 0;
        g.ball_vy = -10000;
        tick(&mut g, 0);
        verify(g.drop_kind[0] == kind);
        verify(capsule_at(&g, 1, 6) == 0 && capsule_at(&g, 3, 6) == 0);
        verify(capsule_at(&g, 0, 6) == -1 && capsule_at(&g, 4, 6) == -1);
    }
}

#[test]
fn test_direction_shots_cover_straight_diagonal_and_sides_at_same_speed() {
    for seed in 1..6 {
        var g: Game = new_game(0);
        g.direction_seed = seed;
        g.ball_vx = 0;
        g.ball_vy = 10000;
        scatter_rebound(&mut g);
        if seed == 1 { verify(g.ball_vx < 0 && g.ball_vy < 0 && !g.side_shot); }
        if seed == 2 { verify(g.ball_vx > 0 && g.ball_vy < 0 && !g.side_shot); }
        if seed == 3 { verify(g.ball_vx < 0 && g.ball_vy == 0 && g.side_shot); }
        if seed == 4 { verify(g.ball_vx > 0 && g.ball_vy == 0 && g.side_shot); }
        if seed == 5 { verify(g.ball_vx == 0 && g.ball_vy == -10000 && !g.side_shot); }
        let squared: i64 = (g.ball_vx / 2) * (g.ball_vx / 2) + g.ball_vy * g.ball_vy;
        verify(magnitude(squared - 100000000) < 30000);
    }
}

#[test]
fn test_direction_shots_override_fixed_tilt_on_real_paddle_contact() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 7);
    collect_capsule(&mut g, 8);
    g.direction_seed = 5;
    g.ready = false;
    g.ball_x = 30000;
    g.ball_y = 11990;
    g.ball_vx = 0;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.ball_vx == 0 && g.ball_vy == -10000);
    verify(g.scatter_ticks > 0 && g.ball_y < paddle_surface(&g, g.ball_x));
}

#[test]
fn test_horizontal_shots_turn_up_at_either_wall_even_after_effect_expiry() {
    for side in 0..2 {
        var g: Game = new_game(0);
        g.ready = false;
        g.ball_x = side == 0 ? 10 : 59990;
        g.ball_y = 10000;
        g.ball_vx = side == 0 ? -20000 : 20000;
        g.ball_vy = 0;
        g.side_shot = true;
        tick(&mut g, 0);
        verify(g.ball_vy < 0 && !g.side_shot);
        verify(side == 0 ? g.ball_vx > 0 : g.ball_vx < 0);
        verify(g.ball_x >= 0 && g.ball_x < 60000);
    }
}

#[test]
fn test_hole_is_visible_and_ball_falls_through_the_middle() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 9);
    verify(paddle_at(&g, 28, 14) && !paddle_at(&g, 29, 14));
    verify(!paddle_at(&g, 30, 14) && paddle_at(&g, 31, 14));
    g.ready = false;
    g.ball_x = 30000;
    g.ball_y = 13990;
    g.ball_vx = 0;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.ball_vy > 0 && g.ball_y > 14000);
    for i in 0..30 { tick(&mut g, 0); }
    verify(g.lives == 2 && g.hole_ticks == 0);
}

#[test]
fn test_solid_paddle_segments_still_bounce_and_collect_capsules() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 9);
    spawn_capsule(&mut g, 4, 30000, 13990);
    spawn_capsule(&mut g, 4, 28000, 13990);
    g.ready = false;
    g.ball_x = 28000;
    g.ball_y = 13990;
    g.ball_vx = 0;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.drop_kind[0] == 4 && g.drop_y[0] > 14000);
    verify(g.drop_kind[1] == 0 && g.lives == 4);
    verify(g.ball_vy < 0);
}

#[test]
fn test_hole_follows_tilt_expand_and_full_width_paddle() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 1);
    collect_capsule(&mut g, 7);
    collect_capsule(&mut g, 9);
    verify(paddle_hole(&g, 28000) && paddle_hole(&g, 31999));
    verify(!paddle_hole(&g, 27999) && !paddle_hole(&g, 32000));
    verify(!paddle_at(&g, 30, paddle_surface(&g, 30500) / 1000));
    g.ready = false;
    g.ball_x = 30000;
    let hit_surface: i64 = paddle_surface(&g, 30000);
    g.ball_y = hit_surface - 10;
    g.ball_vx = 0;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.ball_vy > 0);
    collect_capsule(&mut g, 5);
    verify(!paddle_at(&g, 30, 14) && paddle_at(&g, 20, 14));
}

#[test]
fn test_held_ball_rests_on_solid_segment_and_hole_expiry_recenters_it() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 9);
    tick(&mut g, 0);
    verify(g.ball_x == 28000 && !paddle_hole(&g, g.ball_x));
    g.hole_ticks = 1;
    tick(&mut g, 0);
    verify(g.ball_x == 30000 && paddle_at(&g, 30, 14));
}

#[test]
fn test_fast_is_exactly_two_times_and_refreshes_without_stacking() {
    var g: Game = new_game(0);
    g.ready = false;
    g.ball_x = 30000;
    g.ball_y = 10000;
    g.ball_vx = 10000;
    g.ball_vy = 10000;
    collect_capsule(&mut g, 10);
    tick(&mut g, 0);
    verify(g.ball_x == 30160 && g.ball_y == 10160);
    collect_capsule(&mut g, 10);
    tick(&mut g, 0);
    verify(g.ball_x == 30320 && g.ball_y == 10320);
    verify(g.ball_vx == 10000 && g.ball_vy == 10000);
    g.fast_ticks = 1;
    tick(&mut g, 0);
    verify(g.ball_x == 30400 && g.ball_y == 10400);
}

#[test]
fn test_fast_combines_with_slow_and_restores_normal_speed() {
    var g: Game = new_game(0);
    g.ready = false;
    g.ball_x = 30000;
    g.ball_y = 10000;
    g.ball_vx = 10000;
    g.ball_vy = 10000;
    collect_capsule(&mut g, 2);
    collect_capsule(&mut g, 10);
    tick(&mut g, 0);
    verify(g.ball_x == 30104 && g.ball_y == 10104);
    g.fast_ticks = 1;
    tick(&mut g, 0);
    verify(g.ball_x == 30156 && g.ball_y == 10156);
    g.slow_ticks = 1;
    tick(&mut g, 0);
    verify(g.ball_x == 30236 && g.ball_y == 10236);
}

#[test]
fn test_fast_still_hits_bricks_and_tilted_paddles() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 10);
    g.ready = false;
    g.ball_x = 1500;
    g.ball_y = 7020;
    g.ball_vx = 0;
    g.ball_vy = -10000;
    tick(&mut g, 0);
    verify(g.bricks[48] == 0 && g.ball_vy > 0);
    collect_capsule(&mut g, 7);
    g.ball_x = 30000;
    g.ball_y = 11990;
    g.ball_vx = 0;
    g.ball_vy = 10000;
    tick(&mut g, 0);
    verify(g.ball_vy < 0 && magnitude(g.ball_vx) == -g.ball_vy * 2);
}

#[test]
fn test_new_effect_timers_freeze_refresh_and_clear_with_wave() {
    var g: Game = new_game(0);
    collect_capsule(&mut g, 8);
    collect_capsule(&mut g, 9);
    collect_capsule(&mut g, 10);
    g.paused = true;
    tick(&mut g, 1);
    verify(g.scatter_ticks == 1500 && g.hole_ticks == 1500 && g.fast_ticks == 1250);
    g.paused = false;
    tick(&mut g, 0);
    verify(g.scatter_ticks == 1499 && g.hole_ticks == 1499 && g.fast_ticks == 1249);
    collect_capsule(&mut g, 8);
    collect_capsule(&mut g, 9);
    collect_capsule(&mut g, 10);
    verify(g.scatter_ticks == 1500 && g.hole_ticks == 1500 && g.fast_ticks == 1250);
    g.side_shot = true;
    fill_wave(&mut g);
    verify(g.scatter_ticks == 0 && g.hole_ticks == 0 && g.fast_ticks == 0 && !g.side_shot);
}
